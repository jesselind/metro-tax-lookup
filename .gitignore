# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
.venv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Data policy (metro-tax-lookup) ---
# Runtime JSON under public/data/ is committed so forks work with npm install + npm run dev.
# Offline inputs (mart, DOLA, cert PDFs, extract scratch) stay local. Download URLs: /sources and README.
# Legacy monolithic parcel-record bundles (build output only); commit plain JSON shards under arapahoe-parcel-record-by-pin/.
public/data/arapahoe-parcel-record-by-pin.json
public/data/arapahoe-parcel-record-by-pin.json.gz

# Ephemeral multi-agent / multi-session handoff notes (gitignored; see repo README)
docs/_working/

# Offline regeneration workspace (government dumps, extract scratch). Not committed
# in bulk (mart, GIS, certs, LG directory). Exception: small irreplaceable build
# inputs with no verified re-download — currently the DOLA Property Tax Entities
# CSV used for PIN-load mills / TE IDs (~46 KiB). See README Data layout.
supporting-data/**
!supporting-data/dola/
!supporting-data/dola/property-tax-entities-export.csv

# Spreadsheets (e.g. DOLA xlsx); prefer CSV exports under supporting-data/ locally
*.xlsx

# Playwright (Phase 6b); keep report/cache dirs out of git
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
