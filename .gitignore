# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
.venv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Data policy (metro-tax-lookup) ---
# Runtime JSON under public/data/ is committed so forks work with npm install + npm run dev.
# Large county/state exports stay local (gitignored). Download URLs: /sources and README.
# Legacy monolithic parcel-record bundles (build output only); commit plain JSON shards under arapahoe-parcel-record-by-pin/.
public/data/arapahoe-parcel-record-by-pin.json
public/data/arapahoe-parcel-record-by-pin.json.gz

# Local-only samples (PII, one-off PDFs) - keep out of version control
supporting-data/_private/*
!supporting-data/_private/.gitkeep
!supporting-data/_private/spotcheck-pin.txt.example

# Ephemeral multi-agent / multi-session handoff notes (gitignored; see repo README)
docs/_working/

# County Assessor Data Mart CSVs + portal layout guides (weekly refresh; not committed)
# Drop full mart export under supporting-data/county-mart/ (portal folder names unchanged).
supporting-data/**/*.csv
!supporting-data/dola/property-tax-entities-export.csv
supporting-data/**/*.docx

# DOLA LGIS spreadsheets (prefer committed property-tax-entities-export.csv)
*.xlsx

# Optional legacy / enrichment inputs (gitignored bulk under supporting-data/refs/)
supporting-data/refs/

# Census / GIS file geodatabases (~150MB each; live under refs/gis/ when present)

# Playwright (Phase 6b); keep report/cache dirs out of git
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
