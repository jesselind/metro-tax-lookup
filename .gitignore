# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
.venv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Data policy (metro-tax-lookup) ---
# Runtime JSON under public/data/ is committed so forks work with npm install + npm run dev.
# Large county/state exports stay local (gitignored). Download URLs: /sources and README.

# Local-only samples (PII, one-off PDFs) - keep out of version control
supporting-data/_private/
!supporting-data/_private/.gitkeep

# Ephemeral multi-agent / multi-session handoff notes (gitignored; see repo README)
docs/_working/

# County Assessor Data Mart CSVs + portal layout guides (weekly refresh; not committed)
supporting-data/**/*.csv
!supporting-data/property-tax-entities-export.csv
supporting-data/**/*.docx

# DOLA LGIS spreadsheets (prefer committed property-tax-entities-export.csv)
*.xlsx

# Local staging for full county mart downloads and DOLA LG directory export
supporting-data-phase-3/
supporting-data-phase-2/

# Colorado special-district shapefile bundle (dlall.*); only .dbf needed for export_special_district_directory.py
supporting-data/dlall/

# Statewide special-district import intermediate JSON (not shipped in public/data)
supporting-data/colorado-all-special-districts.json

# Census / GIS file geodatabases used by enrich_district_json_county_geoids.py (~150MB each)
supporting-data/**/*.gdb/
