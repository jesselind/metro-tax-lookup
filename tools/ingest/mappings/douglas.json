    "format": "tax-district-mill-pdf",
    "taxAreaId": "tax_district_no",
    "lineCode": "authority_no",
    "authorityName": "authority_name",
    "millLevy": "mill_levy"
  },
  "accountMap": {
    "_comment": "Location has account + tax district + situs parts. Values has actual/assessed (multiple rows per account). valuesAggregate=sum matches GIS parcel totals.",
